# ==============================================================================
# RSVP PRO PORTAL - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# When deploying to VERCEL or CLOUDFLARE, add these environment variables in your
# Project Settings -> Environment Variables dashboard.
# ==============================================================================

# Core Application URL (e.g. https://your-project.vercel.app or https://rsvp.yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Optional for testing, Required for Live DB)
# Note: If omitted, the system gracefully runs on zero-config resilient in-memory database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 2. Payment Gateway Configuration (Razorpay / Stripe)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# ------------------------------------------------------------------------------
# 3. Transactional Email & Notifications (Resend / SMTP)
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER=simulated
NOTIFICATION_FROM_EMAIL=invitations@yourdomain.com
NOTIFICATION_FROM_NAME="RSVP Pro Events"

# Resend API (Recommended for Vercel & Cloudflare)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="RSVP Pro <invitations@yourdomain.com>"

# Optional SMTP Settings (if using custom SMTP provider)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password
