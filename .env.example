# ====================================================================
# RSVPify-Style SaaS Environment Configuration
# ====================================================================

# Supabase Local or Hosted Configuration
# For local Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used strictly server-side for admin/cron operations, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# App Base URL (Used for generating absolute public invitation & RSVP links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notification Engine Configuration (simulated / console / resend / sendgrid)
NOTIFICATION_PROVIDER=simulated
NOTIFICATION_FROM_EMAIL=invitations@yourdomain.com
NOTIFICATION_FROM_NAME="RSVP Event Team"
